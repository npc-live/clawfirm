# 抖音爆款分析 + 创作助手 workflow

ask track: "请告诉我你的垂直赛道是什么？（例如：美食、美妆、健身、职场等）"
ask ref_audio_url: "声音克隆参考音频，本地路径或 URL 均可（5-30秒，干净单人声，无背景音乐）"
ask avatar_image_url: "人物形象图片，本地路径或 URL 均可（将用于生成视频并对口型）"

# Agent 定义
agent social-cli-agent:
  model: sonnet
  tools: ["browser_shortcut", "read", "write"]
  prompt: "你是社交媒体数据采集专家。使用 browser_shortcut 工具调用 douyin.yaml 的命令来抓取抖音数据。例如搜索：browser_shortcut(file='douyin.yaml', command='search', args=['关键词'])。"

agent analyst-agent:
  model: sonnet
  tools: ["browser_shortcut", "bash", "read", "write", "media_understand"]
  prompt: "你是内容分析专家，擅长拆解短视频的爆款逻辑和流量密码。你可以下载视频并用 media_understand 工具来分析视频内容。"

agent writer-agent:
  model: sonnet
  tools: ["bash", "read", "write"]
  prompt: "你是短视频编剧，擅长写抖音爆款脚本，文风活泼有网感。"

agent kling-agent:
  model: sonnet
  tools: ["bash", "write", "read"]
  prompt: """
  你是 Kling API 调用专家。规则：
  - 从环境变量读取 KLING_AK / KLING_SK，每次请求前用以下命令生成 JWT：
    python3 -c "import time,jwt,os; ak=os.environ['KLING_ACCESS_KEY']; sk=os.environ['KLING_SECRET_KEY']; print(jwt.encode({'iss':ak,'exp':int(time.time())+1800,'nbf':int(time.time())-5}, sk, algorithm='HS256', headers={'alg':'HS256','typ':'JWT'}))"
  - 所有任务异步：POST 提交获取 task_id → 每 5 秒轮询 GET → task_status == "succeed" 为完成
  - 超时上限 600 秒
  - Base URL: https://api.klingai.com
  """

agent summary-agent:
  model: sonnet
  tools: ["bash", "read", "write"]
  prompt: "你是内容策划，擅长总结归纳，给出可执行的建议。"

# Phase 1: 在抖音搜索该赛道的爆款视频
let search-results = session: social-cli-agent
  prompt: """
  在抖音搜索「{track}」相关的爆款视频。
  使用 browser_shortcut 工具：file="douyin.yaml", command="search", args=["{track}"]
  整理搜索结果，输出视频标题、链接等核心数据。

  **IMPORTANT — Persist Output:**
  保存到: ~/.clawfirm/canvas/douyin-viral/01-search-results.md
  文件开头必须有 front-matter:
  ---
  project: "抖音爆款分析"
  step: "01 - 搜索结果"
  agent: social-cli-agent
  date: [今天日期]
  ---
  """

# Phase 2: 下载爆款视频 + 分析
let video-analysis = session: analyst-agent
  prompt: """
  下载并深度分析抖音爆款视频。

  ## 输入
  读取文件: ~/.clawfirm/canvas/douyin-viral/01-search-results.md

  ## 任务
  1. 读取搜索结果，选出互动量最高的 5 个视频
  2. 对每个视频（video-01 ~ video-05）：
     a. 用 browser_shortcut 下载视频：
        file="douyin.yaml", command="download", args=["视频链接"]
        download 命令会自动处理 blob: URL（通过抖音 web API 获取真实视频地址）。
        视频会下载到浏览器默认下载目录（~/Downloads/）。
     b. 将下载的视频移到工作目录并截取前30秒：
        mv ~/Downloads/<下载文件名>.mp4 ~/.clawfirm/canvas/douyin-viral/video-0N.mp4
        ffmpeg -y -i ~/.clawfirm/canvas/douyin-viral/video-0N.mp4 -t 30 -c copy ~/.clawfirm/canvas/douyin-viral/video-0N-clip.mp4
     c. 如果 browser_shortcut download 返回的 dl_result 不是 "video_downloading"（如 api_error、no_media_found），
        则用备用方案：通过 bash 在浏览器内调用抖音 web API 获取真实 URL 后用 curl 下载：
        - 从视频链接提取 aweme_id（/video/数字 中的数字部分）
        - curl 获取 API 数据：
          curl -s "https://www.douyin.com/aweme/v1/web/aweme/detail/?aweme_id=<aweme_id>&aid=6383&cookie_enabled=true" \
            -H "Referer: https://www.douyin.com/" \
            -H "Cookie: <从浏览器获取的cookie>"
        - 从返回 JSON 提取 aweme_detail.video.play_addr.url_list[0]
        - curl -s -L -o <输出路径> -H "Referer: https://www.douyin.com/" "<real_video_url>"
     d. 截取关键帧用于分析（0s, 3s, 10s, 20s, 30s）：
        ffmpeg -y -i ~/.clawfirm/canvas/douyin-viral/video-0N-clip.mp4 \
          -vf "select='eq(n\,0)+eq(n\,90)+eq(n\,300)+eq(n\,600)+eq(n\,900)',setpts=N/FRAME_RATE/TB" \
          -frames:v 5 ~/.clawfirm/canvas/douyin-viral/video-0N-frame-%d.jpg
     e. 用 media_understand 分析视频片段或关键帧：
        file=<clip或帧路径>, prompt="分析这个短视频的: 1)开头3秒钩子手法 2)画面构图与节奏 3)BGM风格 4)字幕/文案风格 5)情绪引导策略"
  3. 综合 5 个视频的分析结果，从以下维度总结每个视频为什么能火：
     - 封面/标题（开头3秒吸引力）
     - 内容结构（开头、正文、结尾）
     - 情绪价值（引发什么情绪共鸣）
     - 互动设计（评论区引导、挑战等）
     - BGM/配乐选择
     - 发布时间与频率
  4. 归纳 Top 5 视频的共性爆款规律（至少 5 条）

  **IMPORTANT — Persist Output:**
  保存到: ~/.clawfirm/canvas/douyin-viral/02-video-analysis.md
  文件开头必须有 front-matter:
  ---
  project: "抖音爆款分析"
  step: "02 - 视频分析"
  agent: analyst-agent
  date: [今天日期]
  ---
  """

# Phase 3: 基于分析结果，帮用户写出自己的爆款脚本
let script = session: writer-agent
  prompt: """
  根据分析结果，帮用户写一个同赛道爆款视频脚本。

  ## 输入
  读取文件: ~/.clawfirm/canvas/douyin-viral/02-video-analysis.md

  ## 用户信息
  赛道: {track}

  ## 任务
  基于爆款视频分析规律，帮用户写一个1分钟左右的短视频脚本，要求：
  1. 标题：3种不同风格的爆款标题方案
  2. 封面文案：吸引点击的封面文字
  3. 脚本正文（分镜头）：
     - 0-3秒：开头钩子（如何留住观众）
     - 3-50秒：内容主体（反转/干货/共鸣点）
     - 50-60秒：结尾引导（评论/关注/点赞）
  4. BGM建议：推荐适合的热门音乐
  5. 发布时机建议

  **IMPORTANT — Persist Output:**
  保存到: ~/.clawfirm/canvas/douyin-viral/03-script.md
  文件开头必须有 front-matter:
  ---
  project: "抖音爆款分析"
  step: "03 - 创作脚本"
  agent: writer-agent
  date: [今天日期]
  ---
  """

# Phase 4: 提炼口播文案
let voiceover = session: writer-agent
  prompt: """
  基于爆款分析和脚本，提炼一段适合视频配音的口播文案。

  ## 输入
  读取文件:
  - ~/.clawfirm/canvas/douyin-viral/02-video-analysis.md（爆款规律）
  - ~/.clawfirm/canvas/douyin-viral/03-script.md（创作脚本）

  ## 赛道
  {track}

  ## 任务
  生成两个版本的口播文案：

  ① 短版（≤120字，用于 Kling lip-sync text2video）：
     - 开头3秒钩子 + 核心价值主张 + 行动号召
     - 口语化，有感染力，一气呵成

  ② 长版（200-300字，完整口播脚本）：
     - 引入痛点 → 我的方案/故事 → 结果数字/反差 → 号召行动
     - 节奏感强，适合配合画面朗读

  **IMPORTANT — Persist Output:**
  保存到: ~/.clawfirm/canvas/douyin-viral/04-voiceover.md
  文件开头必须有 front-matter:
  ---
  project: "抖音爆款分析"
  step: "04 - 口播文案"
  agent: writer-agent
  short_copy: "[短版文案]"
  ---

  正文包含完整的短版和长版文案。
  """

# Phase 5a: 上传参考音频到 Minimax
let upload_result = session: kling-agent
  prompt: """
  将声音克隆参考音频上传到 Minimax。

  从环境变量读取 MINIMAX_API_KEY。
  "{ref_audio_url}" 可能是本地路径，也可能是 HTTP URL。

  - 如果是本地路径：
    curl -X POST https://api.minimax.io/v1/files/upload \
      -H "Authorization: Bearer $MINIMAX_API_KEY" \
      -F 'purpose="voice_clone"' \
      -F "file=@{ref_audio_url}"
  - 如果是 HTTP URL：先下载到 /tmp/ref_audio.mp3，再上传：
    curl -L -o /tmp/ref_audio.mp3 "{ref_audio_url}"
    curl -X POST https://api.minimax.io/v1/files/upload \
      -H "Authorization: Bearer $MINIMAX_API_KEY" \
      -F 'purpose="voice_clone"' \
      -F "file=@/tmp/ref_audio.mp3"

  从响应 file.file_id 获取 source_file_id。

  **IMPORTANT — Persist Output:**
  写入 ~/.clawfirm/canvas/douyin-viral/05a-upload.json：
  {
    "source_file_id": "<file_id>",
    "created_at": "[ISO]"
  }

  输出 source_file_id。
  """

# Phase 5b: 创建 Minimax 声音克隆
let voice_result = session: kling-agent
  prompt: """
  使用已上传的音频文件创建 Minimax 声音克隆。

  读取 ~/.clawfirm/canvas/douyin-viral/05a-upload.json，获取 source_file_id。
  从环境变量读取 MINIMAX_API_KEY。

  curl -X POST https://api.minimax.io/v1/voice_clone \
    -H "Authorization: Bearer $MINIMAX_API_KEY" \
    -H "Content-Type: application/json" \
    -d '{
      "file_id": <source_file_id>,
      "voice_id": "custom_viral_voice"
    }'

  从响应提取 voice_id。
  如果克隆失败，使用 fallback voice_id: "chengshu_jiejie"，并标记 is_fallback: true。

  **IMPORTANT — Persist Output:**
  写入 ~/.clawfirm/canvas/douyin-viral/05b-voice.json：
  {
    "voice_id": "<voice_id>",
    "is_fallback": <true/false>,
    "created_at": "[ISO]"
  }

  输出 voice_id。
  """

# Phase 5c: Minimax TTS 生成音频（5-10s）
let tts_result = session: kling-agent
  prompt: """
  使用克隆声音，通过 Minimax TTS 将口播文案合成为音频文件。

  ## 读取依赖数据
  - ~/.clawfirm/canvas/douyin-viral/05b-voice.json → voice_id
  - ~/.clawfirm/canvas/douyin-viral/04-voiceover.md → front-matter 中的 short_copy（短版文案）

  从环境变量读取 MINIMAX_API_KEY。

  ## 调用 TTS API
  curl -X POST "https://api.minimax.io/v1/t2a_v2" \
    -H "Authorization: Bearer $MINIMAX_API_KEY" \
    -H "Content-Type: application/json" \
    -d '{
      "model": "speech-02-hd",
      "text": "<short_copy>",
      "stream": false,
      "voice_setting": {
        "voice_id": "<voice_id>",
        "speed": 1.0,
        "vol": 1.0,
        "pitch": 0
      },
      "audio_setting": {
        "sample_rate": 32000,
        "bitrate": 128000,
        "format": "mp3"
      }
    }'

  响应中 audio_file 字段是 base64 编码的 mp3。
  用 python3 解码并保存到本地：
  python3 -c "import base64, json, sys; d=json.load(sys.stdin); open('/root/.clawfirm/canvas/douyin-viral/05c-tts.mp3','wb').write(base64.b64decode(d['audio_file']))"

  **IMPORTANT — Persist Output:**
  写入 ~/.clawfirm/canvas/douyin-viral/05c-tts.json：
  {
    "audio_path": "~/.clawfirm/canvas/douyin-viral/05c-tts.mp3",
    "voice_id": "<voice_id>",
    "text": "<short_copy>",
    "created_at": "[ISO]"
  }

  输出音频文件路径。
  """

# Phase 5d-5g: 循环生成视频片段（生视频 → 对口型 → 下载 → 截尾帧）
loop until **05f-download.json 存在，且 duration_sec 已记录，视频下载成功完成** (max: 10):

  let base_video = session: kling-agent
    prompt: """
    使用 Kling image2video 从人物图片生成 10 秒基础视频。

    ## 准备输入图片
    检查 ~/.clawfirm/canvas/douyin-viral/05g-last-frame.jpg 是否存在：
    - 如果存在：使用该文件（上一轮的尾帧），用 python3 base64 编码
    - 如果不存在：使用用户提供的 "{avatar_image_url}"
      - 本地路径：python3 base64 编码
      - HTTP URL：直接用原值

    ## 生成 JWT
    从环境变量读取 KLING_ACCESS_KEY / KLING_SECRET_KEY：
    python3 -c "import time,jwt,os; ak=os.environ['KLING_ACCESS_KEY']; sk=os.environ['KLING_SECRET_KEY']; print(jwt.encode({'iss':ak,'exp':int(time.time())+1800,'nbf':int(time.time())-5}, sk, algorithm='HS256', headers={'alg':'HS256','typ':'JWT'}))"

    ## 提交任务
    POST https://api.klingai.com/v1/videos/image2video
    {
      "model_name": "kling-v1-6",
      "image": "<base64 或 URL>",
      "prompt": "人物直视镜头，表情自然，嘴唇轻微动作，适合配音合成，背景简洁",
      "negative_prompt": "夸张动作, 闭眼, 侧脸, 快速移动",
      "duration": "10",
      "mode": "std"
    }

    轮询 GET /v1/videos/image2video/{task_id}，每 5 秒一次，直到 task_status == "succeed"（超时 600 秒）。
    获取 video_id 和 video_url。

    **IMPORTANT — Persist Output:**
    写入 ~/.clawfirm/canvas/douyin-viral/05d-base-video.json：
    {
      "video_id": "<video_id>",
      "video_url": "<视频URL>",
      "created_at": "[ISO]"
    }

    输出 video_id 和 video_url。
    """

  let lipsync_result = session: kling-agent
    prompt: """
    使用 Kling lip-sync（audio2video 模式）将 TTS 音频与基础视频合成对口型视频。

    ## 读取依赖数据
    - ~/.clawfirm/canvas/douyin-viral/05d-base-video.json → video_id
    - ~/.clawfirm/canvas/douyin-viral/05c-tts.mp3 → 音频文件（读取并 base64 编码）

    ## 生成 JWT
    从环境变量读取 KLING_ACCESS_KEY / KLING_SECRET_KEY（同上）。

    ## base64 编码音频
    python3 -c "import base64; print(base64.b64encode(open('/root/.clawfirm/canvas/douyin-viral/05c-tts.mp3','rb').read()).decode())"

    ## 提交 Lip-sync 任务
    POST https://api.klingai.com/v1/videos/lip-sync
    {
      "video_id": "<video_id>",
      "mode": "audio2video",
      "audio_type": "file",
      "audio_file": "<base64 编码的 mp3>"
    }

    轮询 GET /v1/videos/lip-sync/{task_id}，每 5 秒一次，直到 succeed（超时 600 秒）。

    **IMPORTANT — Persist Output:**
    写入 ~/.clawfirm/canvas/douyin-viral/05e-lipsync.json：
    {
      "task_id": "<task_id>",
      "final_video_url": "<最终视频URL>",
      "created_at": "[ISO]"
    }

    输出最终视频 URL。
    """

  let download_result = session: kling-agent
    prompt: """
    将对口型视频下载到本地。

    读取 ~/.clawfirm/canvas/douyin-viral/05e-lipsync.json，获取 final_video_url。

    curl -L -o ~/.clawfirm/canvas/douyin-viral/05f-lipsync.mp4 "<final_video_url>"

    用 ffprobe 获取视频时长（秒）：
    ffprobe -v error -show_entries format=duration -of csv=p=0 \
      ~/.clawfirm/canvas/douyin-viral/05f-lipsync.mp4

    **IMPORTANT — Persist Output:**
    写入 ~/.clawfirm/canvas/douyin-viral/05f-download.json：
    {
      "local_path": "~/.clawfirm/canvas/douyin-viral/05f-lipsync.mp4",
      "duration_sec": <时长>,
      "created_at": "[ISO]"
    }

    输出本地路径和视频时长。
    """

  let last_frame = session: kling-agent
    prompt: """
    从对口型视频中截取最后一帧，作为下一轮视频生成的起始图片。

    用 ffmpeg 截取尾帧（最后 0.1 秒处）：
    ffmpeg -y -sseof -0.1 -i ~/.clawfirm/canvas/douyin-viral/05f-lipsync.mp4 \
      -vframes 1 -q:v 2 \
      ~/.clawfirm/canvas/douyin-viral/05g-last-frame.jpg

    **IMPORTANT — Persist Output:**
    写入 ~/.clawfirm/canvas/douyin-viral/05g-last-frame.json：
    {
      "frame_path": "~/.clawfirm/canvas/douyin-viral/05g-last-frame.jpg",
      "source_video": "~/.clawfirm/canvas/douyin-viral/05f-lipsync.mp4",
      "created_at": "[ISO]"
    }

    输出尾帧路径。
    """

# Phase 5h: 汇总视频结果
let viral_video = session: kling-agent
  prompt: """
  汇总所有视频生成的中间结果，写入最终结果文件。

  读取以下文件：
  - ~/.clawfirm/canvas/douyin-viral/05b-voice.json → voice_id
  - ~/.clawfirm/canvas/douyin-viral/05d-base-video.json → video_id, video_url
  - ~/.clawfirm/canvas/douyin-viral/05e-lipsync.json → final_video_url
  - ~/.clawfirm/canvas/douyin-viral/05f-download.json → local_path, duration_sec
  - ~/.clawfirm/canvas/douyin-viral/05g-last-frame.json → frame_path
  - ~/.clawfirm/canvas/douyin-viral/04-voiceover.md → front-matter 中的 short_copy

  **IMPORTANT — Persist Output:**
  写入 ~/.clawfirm/canvas/douyin-viral/05-video-result.json：
  {
    "voice_id": "<voice_id>",
    "base_video_id": "<video_id>",
    "base_video_url": "<base视频URL>",
    "final_video_url": "<lip-sync最终视频URL>",
    "local_video_path": "<本地视频路径>",
    "duration_sec": <时长>,
    "last_frame_path": "<尾帧路径>",
    "short_copy": "<短版文案>",
    "created_at": "[ISO]"
  }

  输出最终视频本地路径、时长和尾帧路径。
  """

# Phase 6: 生成索引文件汇总所有结果
let summary = session: summary-agent
  prompt: """
  读取以下所有文件，生成一份简洁的汇总报告：
  - ~/.clawfirm/canvas/douyin-viral/01-search-results.md
  - ~/.clawfirm/canvas/douyin-viral/02-video-analysis.md
  - ~/.clawfirm/canvas/douyin-viral/03-script.md

  输出一个易读的汇总，包含：
  1. 赛道概述
  2. Top 5 爆款视频的共性规律
  3. 给用户的创作建议（可直接落地执行）

  **IMPORTANT — Persist Output:**
  保存到: ~/.clawfirm/canvas/douyin-viral/00-index.md
  文件开头必须有 front-matter:
  ---
  project: "抖音爆款分析"
  step: "00 - 总览"
  agent: summary-agent
  date: [今天日期]
  ---
  """
